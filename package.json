{
  "name": "fortesdrive-desktop",
  "version": "1.3.0",
  "description": "FortesDrive Desktop Client — sincronização local com a nuvem",
  "author": "FortesDrive",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:all": "electron-builder --win nsis --mac dmg",
    "test": "node --test tests/*.test.cjs"
  },
  "build": {
    "appId": "com.fortesdrive.desktop",
    "productName": "FortesDrive",
    "artifactName": "FortesDrive-Setup-${version}.${ext}",
    "copyright": "Copyright © 2026 FortesDrive",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "sync-engine.js",
      "native-files.js",
      "shell-status.js",
      "updater.js",
      "badge-setup.js",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "shell/FortesDriveOverlays.dll",
        "to": "shell/FortesDriveOverlays.dll"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "include": "build/overlays.nsh",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FortesDrive",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "1046"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      },
      "icon": "build/icon.icns",
      "format": "ULFO"
    },
    "publish": {
      "provider": "github",
      "owner": "romulojenischfortes",
      "repo": "fortesdrive-desktop",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-store": "^8.2.0",
    "node-fetch": "^3.3.2",
    "electron-updater": "^6.3.9"
  }
}
